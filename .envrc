# Loaded by direnv on entering the repo. Run `direnv allow` once to trust it.
# Creates the virtual environment on first use, then activates it.
if [ ! -d .venv ]; then
  python3.14 -m venv .venv
  .venv/bin/pip install -r requirements.txt
fi
source .venv/bin/activate

# Model weights live here (git-ignored); Hugging Face cache stays inside it too.
export CABOSSE_WEIGHTS="$PWD/weights"
export HF_HOME="$CABOSSE_WEIGHTS/hf-cache"
