# Generated by scripts/f2/floorplan.py: edit that, not this file.
# The core's floorplan on F2 (one hard pblock per SLR); the script says why.

# Each SLR's pblock: pblock_CL's clock-region ranges clipped to the SLR's rows.
foreach slr {0 1 2} {
  set rows {}
  foreach cr [get_clock_regions -of_objects [get_slrs SLR$slr]] {
    if {![regexp {Y(\d+)$} $cr -> row]} {error "floorplan: clock region $cr"}
    lappend rows $row
  }
  set lo [lindex [lsort -integer $rows] 0]
  set hi [lindex [lsort -integer $rows] end]
  set pb [create_pblock pblock_slr$slr]
  set_property PARENT [get_pblocks pblock_CL] $pb
  foreach range [get_property GRID_RANGES [get_pblocks pblock_CL]] {
    if {![regexp {^CLOCKREGION_X(\d+)Y(\d+):CLOCKREGION_X(\d+)Y(\d+)$} $range -> x0 y0 x1 y1]} {
      error "floorplan: pblock_CL range $range is not a clock-region range"
    }
    if {$y0 < $lo} {set y0 $lo}
    if {$y1 > $hi} {set y1 $hi}
    if {$y0 <= $y1} {resize_pblock $pb -add CLOCKREGION_X${x0}Y${y0}:CLOCKREGION_X${x1}Y${y1}}
  }
  set_property IS_SOFT FALSE $pb
}

# The engine: each group's lanes, DMAs and registers in the group's SLR
